# Application and database
APP_ENV=development
DATABASE_URL=sqlite:///./b2b_agent.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
AUTO_CREATE_SCHEMA=true

# Docker Compose builds DATABASE_URL inside each backend container from these
# values. This avoids interpolating the database password in compose.yaml and
# correctly URL-encodes special characters. Set false to use DATABASE_URL as-is.
BUILD_DATABASE_URL_FROM_MYSQL=true
RUN_MIGRATIONS=true
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Authentication. Development defaults to disabled. Production must set
# AUTH_DISABLED=false and replace JWT_SECRET with at least 32 random characters.
AUTH_DISABLED=true
API_TOKENS={"local-admin":"admin","local-operator":"operator","local-viewer":"viewer"}
JWT_SECRET=development-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# Inquiry extraction
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_TIMEOUT_SECONDS=30

# Pricing and automatic FX synchronization
DEFAULT_FX_RATE=7.20
FX_API_URL=https://api.frankfurter.dev/v1/latest
FX_API_KEY=
FX_API_KEY_HEADER=apikey
FX_TIMEOUT_SECONDS=15
FX_BASE_CURRENCY=USD
FX_SYMBOLS=CNY,USD,EUR,GBP,JPY,HKD
FX_SYNC_PAIRS=USD/CNY,EUR/CNY,GBP/CNY
FX_SYNC_INTERVAL_SECONDS=3600

# Redis, Celery worker, retry, and queue scanning
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
ENQUEUE_DISTRIBUTIONS=true
DISTRIBUTION_SCAN_INTERVAL_SECONDS=30
DISTRIBUTION_SCAN_LIMIT=200
DISTRIBUTION_MAX_ATTEMPTS=5
DISTRIBUTION_RETRY_BASE_SECONDS=30
DISTRIBUTION_RETRY_MAX_SECONDS=3600
DISTRIBUTION_STUCK_SECONDS=900

# Shared outbound HTTP and signed delivery callbacks
CHANNEL_HTTP_TIMEOUT_SECONDS=15
DELIVERY_WEBHOOK_SECRET=

# Email (choose SSL or STARTTLS, never both)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=B2B 报价中心
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Enterprise WeChat. App messages use CORP_ID/SECRET/AGENT_ID. A group robot
# can instead use WECOM_WEBHOOK_URL with customer.channel_target=default.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CORP_SECRET=
WECOM_WEBHOOK_URL=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_TIMEOUT_SECONDS=20

# Enterprise WeChat intelligent robot inbound listener. These credentials are
# separate from WECOM_WEBHOOK_URL. Empty ALLOWED_CHAT_IDS accepts every internal
# group where the robot receives an @ mention. Single chats are disabled by default.
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
WECOM_AIBOT_ALLOWED_CHAT_IDS=
WECOM_AIBOT_ACCEPT_SINGLE_CHAT=false
WECOM_AIBOT_AUTO_REPLY=true

# Enterprise WeChat conversation archive for external-customer groups. This is
# a separately licensed capability; the group robot webhook cannot receive it.
# Download the official Linux Finance SDK that matches the worker architecture
# into WECOM_ARCHIVE_SDK_HOST_DIR before enabling the poller.
WECOM_ARCHIVE_ENABLED=false
WECOM_ARCHIVE_SOURCE_ID=default
WECOM_ARCHIVE_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_ARCHIVE_PRIVATE_KEY=
WECOM_ARCHIVE_PRIVATE_KEY_FILE=
WECOM_ARCHIVE_PRIVATE_KEY_VERSION=
WECOM_ARCHIVE_PRIVATE_KEYS_JSON=
WECOM_ARCHIVE_SDK_HOST_DIR=./backend/vendor/wecom-finance-sdk
WECOM_ARCHIVE_SDK_LIBRARY_PATH=/opt/wecom-finance-sdk/libWeWorkFinanceSdk_C.so
WECOM_ARCHIVE_ROOM_IDS=
WECOM_ARCHIVE_EXTERNAL_ONLY=true
WECOM_ARCHIVE_FILTER_CANDIDATES=true
WECOM_ARCHIVE_TRIGGER_PREFIX=
WECOM_ARCHIVE_BATCH_SIZE=100
WECOM_ARCHIVE_MAX_PAGES_PER_POLL=10
WECOM_ARCHIVE_POLL_INTERVAL_SECONDS=30
WECOM_ARCHIVE_TIMEOUT_SECONDS=5
WECOM_ARCHIVE_LEASE_SECONDS=300
WECOM_ARCHIVE_POISON_MAX_ATTEMPTS=3
WECOM_ARCHIVE_RETRY_BASE_SECONDS=30
WECOM_ARCHIVE_RETRY_MAX_SECONDS=900
WECOM_ARCHIVE_MAX_RETRIES=5
WECOM_ARCHIVE_PROXY=
WECOM_ARCHIVE_PROXY_PASSWORD=

# Feishu. App messages use APP_ID/APP_SECRET. A group robot can instead use
# FEISHU_WEBHOOK_URL with customer.channel_target=default.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_RECEIVE_ID_TYPE=open_id
FEISHU_TIMEOUT_SECONDS=20
